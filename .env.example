# ─────────────────────────────────────────────────────────────
#  환경변수 템플릿
#
#  이 파일은 "값이 비어있는 템플릿"이라서 깃에 올라가도 안전합니다.
#  실제 키는 아래 명령으로 .env.local 을 만들어서 넣어주세요.
#
#     cp .env.example .env.local
#
#  .env.local 은 .gitignore 에서 차단되어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# 네이버 개발자센터에서 발급받은 값 (https://developers.naver.com/apps)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 서버 포트 (비워두면 3000)
PORT=3000
